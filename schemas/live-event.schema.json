{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cz-live-event-0.1 accepted mathematical action",
  "description": "Each events.jsonl row. The runtime additionally enforces contiguous sequence numbers, nondecreasing effective ticks within the captured horizon and exact normalized parameters. UI commands are not mathematical events.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "cz-live-event-0.1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "effective_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 215999
    },
    "action": {
      "enum": [
        "left",
        "right",
        "up",
        "down",
        "squash",
        "stretch",
        "reset",
        "wander_on",
        "wander_off"
      ]
    },
    "strength": {
      "type": "number"
    },
    "duration_ticks": {
      "type": "integer",
      "minimum": 30,
      "maximum": 600
    },
    "scope": {
      "const": "all"
    },
    "envelope": {
      "const": "quintic-target-v1"
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "effective_tick",
    "action",
    "strength",
    "duration_ticks",
    "scope",
    "envelope"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "left",
              "right",
              "up",
              "down"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "strength": {
            "minimum": 0.05,
            "maximum": 0.3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "squash",
              "stretch"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "strength": {
            "minimum": 0.05,
            "maximum": 0.6
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "reset",
              "wander_on",
              "wander_off"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "strength": {
            "const": 0.0
          },
          "duration_ticks": {
            "const": 120
          }
        }
      }
    }
  ]
}
