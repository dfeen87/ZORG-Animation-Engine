{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "cz-morph-target-0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "basis": {
      "const": "home-relative-world-half-height"
    },
    "element_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "offsets": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 1
    },
    "field_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schema_version",
    "id",
    "basis",
    "element_ids",
    "offsets",
    "field_sha256",
    "description",
    "attribution"
  ],
  "additionalProperties": false,
  "description": "Runtime additionally checks sorted scene IDs, field binding, finite numbers, force/displacement limits, exact offset dimensions and zero home offsets."
}
