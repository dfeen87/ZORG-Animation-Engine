{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cz-run-status-0.3",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "cz-run-status-0.3"
    },
    "scene_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "state": {
      "enum": [
        "running",
        "failed",
        "complete"
      ]
    },
    "last_committed_tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "error_code": {
      "enum": [
        null,
        "NUMERICAL_REJECTION",
        "EXPORT_FAILURE"
      ]
    }
  },
  "required": [
    "schema_version",
    "scene_id",
    "state",
    "last_committed_tick",
    "error_code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error_code": {
            "enum": [
              "NUMERICAL_REJECTION",
              "EXPORT_FAILURE"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "error_code": {
            "type": "null"
          }
        }
      }
    }
  ]
}
